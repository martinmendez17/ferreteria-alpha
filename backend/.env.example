# Copia este archivo como .env y completa los valores.

# Conexión a PostgreSQL. Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ferreteria_alpha"
# En Neon se ve así (incluye SSL):
# DATABASE_URL="postgresql://usuario:clave@ep-xxxx.neon.tech/ferreteria_alpha?sslmode=require"

# Clave para firmar los tokens de sesión (usa un texto largo y aleatorio)
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"

PORT=3000
# Origen del frontend permitido por CORS
FRONTEND_URL="http://localhost:5173"
