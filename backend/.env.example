# Copia este archivo como .env y completa los valores. NUNCA subas el .env a GitHub.

# Conexión a MongoDB.
#  - Local:   mongodb://127.0.0.1:27017/?replicaSet=rs0   (las transacciones necesitan replica set)
#  - Atlas:   mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ferreteria_alpha

# Texto largo e inventado para firmar las sesiones (JWT). Cámbialo por uno propio.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto
JWT_EXPIRES_IN=8h

# Dirección del frontend. Se usa para CORS y para armar el enlace del correo de recuperación.
# Puedes poner varias separadas por coma (la primera se usa en los correos).
FRONTEND_URL=http://localhost:5173

PORT=3000

# Correo de recuperación de contraseña (Brevo, plan gratuito: 300 correos al día).
# Si BREVO_API_KEY queda vacío, el enlace se muestra en la consola del servidor (modo desarrollo).
BREVO_API_KEY=
CORREO_REMITENTE=tu.correo@gmail.com
NOMBRE_REMITENTE=Ferretería Alpha
