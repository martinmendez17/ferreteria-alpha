{
  "name": "ferreteria-alpha-api",
  "version": "1.0.0",
  "description": "API REST de Ferretería Alpha: catálogo, autenticación e inventario",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
