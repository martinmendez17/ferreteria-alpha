{
  "name": "ferreteria-alpha-api",
  "version": "2.0.0",
  "description": "API REST de Ferretería Alpha: catálogo, autenticación, inventario y reportes (MongoDB)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:cargar": "tsx scripts/cargar-base.ts",
    "db:probar": "tsx scripts/probar-conexion.ts",
    "db:consultas": "tsx scripts/consultas.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
